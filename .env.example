# Copy this file to .env and fill in the values. Never commit .env.

# --- LLM ---
LLM_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model IDs: check https://ai.google.dev/gemini-api/docs/models for current names
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# gemini-3.8-flash's free-tier daily quota (~20 requests) is too small for QA use; stick with
# the flash-lite model on the free tier (see README "To do before Phase 7" re: billing later).
GEMINI_QA_MODEL=gemini-3.5-flash-lite
# Used only when the main model is still overloaded after all retries (leave empty to disable).
# Use fixed model IDs, not *-latest aliases, so results stay repeatable.
GEMINI_EXTRACTION_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_QA_FALLBACK_MODEL=gemini-2.5-flash
# Per-model request budgets: different models have different free-tier quotas, so each one
# needs its own numbers. Check yours at https://aistudio.google.com/rate-limit for every model
# named above (a model missing here has no client-side limit). JSON: {"<model>": {"rpm": N, "rpd": N}}
GEMINI_MODEL_LIMITS={"gemini-3.5-flash-lite": {"rpm": 15, "rpd": 500}, "gemini-2.5-flash": {"rpm": 10, "rpd": 250}}
GEMINI_MAX_RETRIES=5

# --- Neo4j (docker-compose.yml reads NEO4J_PASSWORD from here too) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters
NEO4J_PASSWORD=change-me-please

LOG_LEVEL=INFO
